# Copy to .env (gitignored). Phase 6 introduces DATABASE_URL + POSTGRES_PASSWORD;
# JWT_SECRET MUST differ from the default `changeme` to invalidate any pre-Phase-6 tokens.

# Postgres connection string consumed by app/config.py::Settings.database_url and
# alembic env.py. Async psycopg driver per ADR-008 / Phase 6 D-01.
DATABASE_URL=postgresql+psycopg://trip_planner:trip_planner@localhost:5432/trip_planner

# Compose db service password (also baked into DATABASE_URL above for the dev default).
POSTGRES_PASSWORD=trip_planner

# Pitfall 4 — uncomment if host port 5432 is taken (e.g. Homebrew Postgres).
# Update DATABASE_URL above to match the chosen port.
# POSTGRES_HOST_PORT=5433

# JWT signing secret. Generate via:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-random-48-byte-token
